config MT7921_COMMON
	tristate
	select MT792x_LIB
	select WANT_DEV_COREDUMP

config MT7921E
	tristate "MediaTek MT7921E (PCIe) support"
	select MT7921_COMMON
	depends on MAC80211
	depends on PCI
	help
	  This adds support for MT7921E 802.11ax 2x2:2SS wireless devices.

	  To compile this driver as a module, choose M here.

config MT7921S
	tristate "MediaTek MT7921S (SDIO) support"
	select MT76_SDIO
	select MT7921_COMMON
	depends on MAC80211
	depends on MMC
	help
	  This adds support for MT7921S 802.11ax 2x2:2SS wireless devices.

	  To compile this driver as a module, choose M here.

config MT7921U
	tristate "MediaTek MT7921U (USB) support"
	select MT792x_USB
	select MT7921_COMMON
	depends on MAC80211
	depends on USB
	help
	  This adds support for MT7921U 802.11ax 2x2:2SS wireless devices.

	  To compile this driver as a module, choose M here.

config MT7921_SOC
	tristate "MediaTek MT7921 (MT6878 CONNSYS) AXI support"
	select MT7921_COMMON
	depends on MAC80211
	depends on ARCH_MEDIATEK || COMPILE_TEST
	depends on OF
	depends on MTK_CONNINFRA
	help
	  This adds support for the MT7921 Wi-Fi core built into the
	  connectivity subsystem (CONNSYS) of the MediaTek MT6878 SoC,
	  attached over AXI. The firmware is loaded by the boot loader.

	  To compile this driver as a module, choose M here.
