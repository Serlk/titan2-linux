/*
 * Titan 2, connectivity bring-up: CONNINFRA (CONNSYS power and bus).
 *
 * On top of the power-domain stage, as the CONN domain comes from SPM.
 * Not built into the default image.
 *
 * The stock LK looks for /soc/consys (then /consys) in our DTB when it
 * loads the CONNSYS firmware. With this node present it reads the hwid-node GPIOs,
 * rewrites "compatible" with the A-die it finds (MT6637 on this board, as
 * in the stock DT) and programs the PMIF for that A-die, as it does under
 * Android. It loads the CONNSYS firmware only when /gps and /wifi carry
 * their EMI properties too; they are not described yet, so that part is
 * still skipped.
 */

#include "mt6878-unihertz-titan2-pd.dts"

&mt6363 {
	regulators@30 {
		/* stock conninfra: 1.35 V, normal mode while CONNSYS is on */
		mt6363_vcn13: vcn13 {
			regulator-name = "mt6363_vcn13";
			regulator-min-microvolt = <1350000>;
			regulator-max-microvolt = <1350000>;
		};

		/* stock conninfra: 1.7 V */
		mt6363_vrfio18: vrf-io18 {
			regulator-name = "mt6363_vrfio18";
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1700000>;
		};
	};
};

&pio {
	/* D-die <-> A-die interface (stock: GPIO_MODE21[31:16], GPIO_MODE22[26:0]) */
	consys_pins_active: consys-active-pins {
		pins-conn {
			pinmux = <PINMUX_GPIO172__FUNC_CONN_TOP_CLK>,
				 <PINMUX_GPIO173__FUNC_CONN_TOP_DATA>,
				 <PINMUX_GPIO174__FUNC_CONN_BT_CLK>,
				 <PINMUX_GPIO175__FUNC_CONN_BT_DATA>,
				 <PINMUX_GPIO176__FUNC_CONN_HRST_B>,
				 <PINMUX_GPIO177__FUNC_CONN_WB_PTA>,
				 <PINMUX_GPIO178__FUNC_CONN_WF_CTRL0>,
				 <PINMUX_GPIO179__FUNC_CONN_WF_CTRL1>,
				 <PINMUX_GPIO180__FUNC_CONN_WF_CTRL2>,
				 <PINMUX_GPIO181__FUNC_CONN_WF_CTRL3>,
				 <PINMUX_GPIO182__FUNC_CONN_WF_CTRL4>;
			/* stock: IOCFG_RT DRV_CFG0 fields = 3'b001 */
			drive-strength = <4>;
		};
	};

	consys_pins_idle: consys-idle-pins {
		pins-conn {
			pinmux = <PINMUX_GPIO172__FUNC_GPIO172>,
				 <PINMUX_GPIO173__FUNC_GPIO173>,
				 <PINMUX_GPIO174__FUNC_GPIO174>,
				 <PINMUX_GPIO175__FUNC_GPIO175>,
				 <PINMUX_GPIO176__FUNC_GPIO176>,
				 <PINMUX_GPIO177__FUNC_GPIO177>,
				 <PINMUX_GPIO178__FUNC_GPIO178>,
				 <PINMUX_GPIO179__FUNC_GPIO179>,
				 <PINMUX_GPIO180__FUNC_GPIO180>,
				 <PINMUX_GPIO181__FUNC_GPIO181>,
				 <PINMUX_GPIO182__FUNC_GPIO182>;
		};
	};
};

&soc {
	/*
	 * LK replaces "compatible" with mediatek,mt6878-{6637,6631,6631-6686}-consys;
	 * the value here is what it writes on this board.
	 */
	consys@18000000 {
		compatible = "mediatek,mt6878-6637-consys";
		reg = <0x18000000 0x100000>;
		power-domains = <&spm MT6878_POWER_DOMAIN_CONN>;
		vcn13-supply = <&mt6363_vcn13>;
		vrfio18-supply = <&mt6363_vrfio18>;
		pinctrl-names = "idle", "active";
		pinctrl-0 = <&consys_pins_idle>;
		pinctrl-1 = <&consys_pins_active>;
		mediatek,topckgen = <&topckgen>;

		/*
		 * Read by LK only (stock values): A-die detection. GPIO 92,
		 * 132 and 131 form the index into adie-sku, 0 = MT6637,
		 * 1 = MT6631, 2 = MT6631 + MT6686.
		 */
		hwid-node = <92 132 131>;
		adie-sku = <1 1 0 0 2 2 1 0>;

		status = "disabled";
	};
};
