/*
 * Titan 2, display bring-up: mediatek-drm on the main panel instead of
 * simplefb and the LK frame trigger.
 *
 * Copyright (c) 2026 serlk <22211586+Serlk@users.noreply.github.com>
 *
 * Handover from LK: the DSI PHY keeps the PLL LK left running, DSI0 keeps
 * LK's D-PHY timings and lane state, the panel driver takes the panel over
 * without a reset, and frames go through the pipeline LK programmed
 * (OVL0_2L ... DSI0, mutex 0). Until mediatek-drm has bound and sent its
 * first frame, nothing on the display path is written: if it never binds,
 * the panel keeps LK's picture from its own frame memory.
 *
 * Builds on the -pd variant (power controller on). The panel power
 * switches are plain GPIOs: always on here, so that the panel stays lit
 * whether or not its driver ever probes; display off is DCS sleep in.
 */

#include "mt6878-unihertz-titan2-pd.dts"

/ {
	chosen {
		/*
		 * Scanout buffers come from CMA below 4 GiB (no IOMMU yet: LK
		 * leaves the display larb ports in bypass). 1440x1440 XRGB8888
		 * is 8.3 MB a buffer; the default 32 MB is too small for fbdev
		 * plus a double buffered client.
		 */
		bootargs = "clk_ignore_unused pd_ignore_unused cma=128M";
	};

	/* panel power switches, in the stock power-up order */
	panel_pm: regulator-panel-pm {
		compatible = "regulator-fixed";
		regulator-name = "panel_pm";
		gpio = <&pio 149 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	panel_vci: regulator-panel-vci {
		compatible = "regulator-fixed";
		regulator-name = "panel_vci";
		gpio = <&pio 40 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	panel_lcm: regulator-panel-lcm {
		compatible = "regulator-fixed";
		regulator-name = "panel_lcm";
		gpio = <&pio 38 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	panel_lcd: regulator-panel-lcd {
		compatible = "regulator-fixed";
		regulator-name = "panel_lcd";
		gpio = <&pio 32 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};
};

/* both would write the registers mediatek-drm now owns */
&{/chosen/simplefb@fe04f000} {
	status = "disabled";
};

&disp_kick {
	status = "disabled";
};

&mmsys {
	power-domains = <&spm MT6878_POWER_DOMAIN_DISP>;
	status = "okay";
};

&disp_mutex0 {
	status = "okay";
};

&disp_ovl0_2l {
	status = "okay";
};

&mipi_tx0 {
	status = "okay";
};

&dsi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&dsi0_te_pins>;
	status = "okay";

	panel@0 {
		compatible = "unihertz,titan2-main-panel";
		reg = <0>;
		reset-gpios = <&pio 90 GPIO_ACTIVE_LOW>;
		touch-reset-gpios = <&pio 6 GPIO_ACTIVE_LOW>;
		pm-supply = <&panel_pm>;
		vci-supply = <&panel_vci>;
		lcm-supply = <&panel_lcm>;
		lcd-supply = <&panel_lcd>;
		backlight = <&backlight>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi0_out>;
			};
		};
	};

	port {
		dsi0_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};
};

&pio {
	/* tearing effect input of DSI0 */
	dsi0_te_pins: dsi0-te-pins {
		pins-te {
			pinmux = <PINMUX_GPIO89__FUNC_DSI_TE>;
			input-enable;
		};
	};
};
